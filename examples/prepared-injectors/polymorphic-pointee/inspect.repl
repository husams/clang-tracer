%probe prepare "HFW::HfwManager::createItem()" --include demo/polymorphic-pointee/item.hpp --output prepared
%probe inject "HFW::HfwManager::createItem()" --prepared prepared --prepared-mode require --snapshot-return-pointee
%collect --name "HFW::HfwManager::createItem()" --count 3 --timeout 15 --phase POST --as captured
auto captured = tracer.batch("captured");
std::size_t child_index = 0;
while (child_index < captured.size() && (captured.at(child_index).result() == "0x0" || captured.at(child_index).result_snapshot().cpp_type() != "HFW::Child")) ++child_index;
auto event = captured.at(child_index);
auto snapshot = event.result_snapshot();
std::cout << snapshot.cpp_type() << " x=" << snapshot.field("x").as<int>() << '\n';
struct ChildFields { int x; };
namespace tracer_repl { template <> struct EventCodec<::ChildFields> { static ::ChildFields decode(const EventValue &value) { return {value.field("x").as<int>()}; } }; }
auto item = event.result_as<ChildFields>();
std::cout << item.x << '\n';
