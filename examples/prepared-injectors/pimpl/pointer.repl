%probe prepare "HFW::HfwManager::createItem(int)" --include demo/pimpl/item.hpp --include demo/pimpl/item-impl.hpp --include demo/pimpl/snapshot-policy.hpp --output pimpl-pointer
%probe inject "HFW::HfwManager::createItem(int)" --prepared pimpl-pointer --prepared-mode require --snapshot-return-pointee
%collect --name "HFW::HfwManager::createItem(int)" --count 7 --timeout 15 --phase POST --as captured
