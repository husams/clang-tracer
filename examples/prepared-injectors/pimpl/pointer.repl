%probe prepare "HFW::HfwManager::createItem(int)" --include demo/pimpl/item.hpp --include demo/pimpl/item-impl.hpp --snapshot-return-member _imp --snapshot-return-type HFW::ItemV1 --output pimpl-pointer
%probe inject "HFW::HfwManager::createItem(int)" --prepared pimpl-pointer --prepared-mode require --snapshot-return-pointee
%collect --name "HFW::HfwManager::createItem(int)" --count 4 --timeout 15 --phase POST --as captured
