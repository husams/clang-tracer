%probe prepare "HFW::HfwManager::createItem(int)" --include demo/pimpl/item.hpp --include demo/pimpl/item-impl.hpp --snapshot-return-member _imp --output pimpl-custom
%probe inject "HFW::HfwManager::createItem(int)" --callback demo/pimpl/encoder.cpp --prepared pimpl-custom --prepared-mode require --snapshot-return-pointee
%collect --name "HFW::HfwManager::createItem(int)" --count 6 --timeout 15 --phase POST --as captured
