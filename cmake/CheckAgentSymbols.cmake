cmake_minimum_required(VERSION 3.20)

if(NOT AGENT OR NOT NM OR NOT READELF)
  message(FATAL_ERROR "AGENT, NM and READELF are required")
endif()
# Older GNU linkers may retain LOCAL entries in .dynsym; they are not exports.
execute_process(COMMAND "${NM}" -D --defined-only --extern-only "${AGENT}"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _symbols ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect agent exports: ${_error}")
endif()
set(_required tracer_agent_start tracer_agent_stop tracer_context_pthread_create_detour)
string(REPLACE "\n" ";" _lines "${_symbols}")
set(_exports)
set(_unexpected)
foreach(_line IN LISTS _lines)
  if(_line STREQUAL "")
    continue()
  endif()
  string(REGEX REPLACE "^.*[ \t]" "" _symbol "${_line}")
  if(NOT _symbol IN_LIST _required)
    list(APPEND _unexpected "${_symbol}")
  endif()
  list(APPEND _exports "${_symbol}")
endforeach()
if(_unexpected)
  list(LENGTH _unexpected _count)
  list(SUBLIST _unexpected 0 10 _sample)
  message(FATAL_ERROR "Agent exposes ${_count} private symbols (first ten): ${_sample}")
endif()
foreach(_symbol IN LISTS _required)
  if(NOT _symbol IN_LIST _exports)
    message(FATAL_ERROR "Agent is missing required entry point ${_symbol}")
  endif()
endforeach()

# Hiding the agent's definitions cannot isolate a dependency in another DSO.
execute_process(COMMAND "${READELF}" -d "${AGENT}"
  RESULT_VARIABLE _result OUTPUT_VARIABLE _dynamic ERROR_VARIABLE _error)
if(NOT _result EQUAL 0)
  message(FATAL_ERROR "Cannot inspect agent dependencies: ${_error}")
endif()
string(REPLACE "\n" ";" _lines "${_dynamic}")
foreach(_line IN LISTS _lines)
  if(_line MATCHES "\\(NEEDED\\).*\\[lib(protobuf[^]]*|grpc[^]]*|gpr|absl[^]]*|re2|cares|z|ssl|crypto|upb|address_sorting)\\.so[^]]*\\]")
    message(FATAL_ERROR
      "Agent has a shared transport dependency: ${_line}. Build PIC static protobuf/gRPC and their dependencies; see docs/build-rhel.md.")
  endif()
endforeach()
message(STATUS "Agent exports only its three entry points and has no shared transport dependencies")
